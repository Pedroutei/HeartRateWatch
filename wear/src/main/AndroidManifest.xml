<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- So getLaunchIntentForPackage("com.strava") can actually see the app when the "Launch
         Strava on start" setting is on: required since API 30's package visibility changes,
         otherwise every other app is invisible to a query like this by default. -->
    <queries>
        <package android:name="com.strava" />
    </queries>

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="false" />

    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Always used for a RUNNING exercise (there's no accelerometer-based distance fallback on
         this hardware); a STATIONARY_BIKE exercise (calibration, or the bike activity mode)
         never enables GPS at all, so this permission simply goes unused during those. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Marks this as a standalone watch app (it works without the phone app installed,
             even though the phone app adds settings + audio alerts on top). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CalibrationActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- exported: both of these are launched via the Tile's AndroidActivity action, which
             comes from the system's Tile-rendering process (not from inside this app), so
             exported="false" would risk the Tile's taps silently doing nothing.

             taskAffinity="": on Wear OS, pressing back from an activity that's the root of its
             own task doesn't finish it, it just backgrounds the task (so the watch face shows
             again) while the activity stays alive underneath. Without a taskAffinity override,
             both of these default to sharing the app's normal task, so launching one of them
             via FLAG_ACTIVITY_NEW_TASK (required for a launch from the Tile's separate process)
             could resurface an old, still-alive instance of the OTHER one instead of starting
             clean, e.g. backing out of "Change mode" and then tapping Stop on the tile would
             bring "Change mode" back to the foreground under TileActionActivity's instant finish.
             Giving each an empty affinity means every tile tap always gets its own fresh task. -->
        <activity
            android:name=".ExercisePickerActivity"
            android:exported="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Invisible tap target for the Tile's start/stop chip: see TileActionActivity. -->
        <activity
            android:name=".TileActionActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".PhoneMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/calibration" />
            </intent-filter>
        </service>

        <!-- foregroundServiceType includes "location", not just "health": confirmed via Logcat
             that Health Services re-verifies ACCESS_FINE_LOCATION periodically for the whole
             session, and that re-check needs the app to qualify for sustained "while in use"
             location access even with no visible Activity open. A location-typed foreground
             service is Android's own documented mechanism for exactly that (it's how apps like
             Strava/Maps track GPS with the screen off); a plain health-typed one apparently
             doesn't count for Health Services' own internal check. -->
        <service
            android:name=".ExerciseSessionService"
            android:exported="false"
            android:foregroundServiceType="health|location" />

        <service
            android:name=".SettingsSyncListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/settings" />
            </intent-filter>
        </service>

        <!-- android:resource: the static thumbnail shown in the watch face's "Add tile" carousel
             while browsing, since actually invoking onTileRequest there isn't guaranteed to be
             fast (or even supported) on every OS version. See drawable/tile_preview.xml. -->
        <service
            android:name=".tile.HeartRateTileService"
            android:label="@string/tile_label"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

    </application>

</manifest>
